# 本地数据放在工程外；~ 会展开为当前用户主目录。相对路径仍以 backend/ 为基准。
# 容器部署时显式设为容器内的持久化挂载目录，例如 /data。
APP_DATA_DIR=~/.niuma-crew/data
# 当前支持文件型 SQLite；URL 中的相对文件路径以 APP_DATA_DIR 为基准。
DATABASE_URL=sqlite+pysqlite:///app.db
# Chroma 持久索引默认在业务数据库旁 knowledge-vectors/；相对覆盖路径以 APP_DATA_DIR 为基准。
# KNOWLEDGE_VECTOR_DIR=knowledge-vectors
SQLITE_BUSY_TIMEOUT_MS=5000
# 与数据库连接独立；相对路径以 APP_DATA_DIR 为基准，也支持绝对路径。
MODEL_CONNECTIONS_KEY_FILE=model-connections.key
# 同一数据库的服务进程必须共享该文件；当前仅支持单机、单后端进程。
RUNNER_LOCK_FILE=runner.lock

# 聊天模型与 API Key 通过管理员的大脑配置保存，再由员工选择连接。

# 可选运行预算：默认值集中在 app/execution/config.py；修改后重启，新提交和重试生效。
# LangGraph 计算步数上限，不等于模型调用次数；过小可能在模型回答前耗尽。
# RUN_RECURSION_LIMIT=64
# 普通 Agent 每次运行的模型调用次数上限。
# RUN_MAX_MODEL_CALLS=8
# 自动摘要使用官方中间件，摘要请求同样消耗本 Run 的模型次数。
# RUN_SUMMARY_TRIGGER_TOKENS=16384
# RUN_SUMMARY_KEEP_TOKENS=4096
# 每次运行的技能加载次数上限，显式预加载与实际读取共用预算。
# RUN_MAX_SKILL_READS=16
# RUN_MAX_TOOL_CALLS=32

# MCP 支持直接接入 HTTP(S)、本机与私网服务，无需部署域名白名单。
# 可信本机 MCP 默认关闭；程序拥有后端宿主账号权限，只有管理员可登记。
# TOOL_MCP_STDIO_ENABLED=false
# TOOL_MCP_STDIO_MAX_PROCESSES=4
# TOOL_MCP_STDIO_WAIT_SECONDS=10
# OAuth 回调必须和浏览器访问平台的来源一致；线上使用 HTTPS，勿混用 localhost/127.0.0.1。
# TOOL_OAUTH_CALLBACK_URL=http://localhost:3000/api/tool-connections/oauth/callback
# 工具密文使用 MODEL_CONNECTIONS_KEY_FILE 同目录下追加 .tools 的独立主密钥文件。
# 配置 MODEL_CONNECTIONS_ENCRYPTION_KEY 时两类密文都使用该稳定的注入密钥。

# 不可变文件存储。路径相对于 APP_DATA_DIR，需和数据库一起备份。
# FILES_DIRECTORY=files
# FILES_MAX_FILE_BYTES=10485760
# FILES_MAX_RUN_BYTES=41943040
# FILES_MAX_OWNER_BYTES=268435456
# 独立证据配额；不会挤占上传/产物容量。超额时证据缺失，不中断对话或考核。
# FILES_MAX_EVIDENCE_RUN_BYTES=67108864
# FILES_MAX_EVIDENCE_OWNER_BYTES=536870912
# FILES_RETENTION_SECONDS=86400

# Skill 可编辑目录默认 ~/.agents/skills（运行后端的系统用户），与采用该目录的 CLI 互通。
# 云部署可显式指定持久目录；相对路径基于 APP_DATA_DIR。不可变运行字节默认数据库父目录下 skill-assets。
# 两个位置不能相同。已有旧版数据库同级技能目录可显式配置原路径继续使用。
# SKILL_LIBRARY_DIR=~/.agents/skills
# SKILL_STORAGE_DIR=skill-assets

# 自托管沙箱；只有目标 Linux 的真实验收通过后才会就绪，配置方法见 docs/guides/agent-tools.md。
# OPENSANDBOX_ENDPOINT=http://127.0.0.1:8080
# OPENSANDBOX_API_KEY=<server-side key>
# OPENSANDBOX_IMAGE=registry.example.com/niuma-workload@sha256:<digest>
# OPENSANDBOX_DEPLOYMENT_ID=niuma-crew
# OPENSANDBOX_VERIFIED_PROFILE=/etc/niuma-sandbox/verified-profile.json

# 浏览器会话。生产环境使用真实 HTTPS 来源并开启 Secure；不要保留开发来源。
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUTH_COOKIE_SECURE=false
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=86400
AUTH_GUEST_MAX_AGE_SECONDS=604800

# 可选 GitHub 登录：三项全部配置后启用；缺省时保留管理员密码和游客入口。
# 创建专用于登录的 OAuth App，不请求邮箱、仓库或组织权限。
# 浏览器访问地址必须和回调的来源一致（localhost 与 127.0.0.1 不混用）。
# GITHUB_OAUTH_CLIENT_ID=<OAuth App client ID>
# GITHUB_OAUTH_CLIENT_SECRET=<server-side secret>
# GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/api/auth/github/callback

# 可选：部署时注入稳定的 Fernet 主密钥，优先于文件；未设置时首次保存大脑创建上述密钥文件。
# 主密钥与数据库分别备份；不要设置为空或直接更换已有主密钥。
# MODEL_CONNECTIONS_ENCRYPTION_KEY=<Fernet key from your secret manager>


# 可选：生产静态资源目录；相对路径以 backend/ 为基准。开发默认使用 frontend/dist。
# FRONTEND_DIST=../frontend/dist
