# 源码部署示例：复制到 backend/.env，按实际域名和持久目录修改。
# 不覆盖已有环境文件、数据库或密钥。Docker Compose 配置见公开版本 deploy/app.env.example。
APP_DATA_DIR=/srv/niuma-crew/data
AUTH_ALLOWED_ORIGINS=https://crew.example.com
AUTH_COOKIE_SECURE=true

# 工具 OAuth 默认使用受信任的浏览器来源，无需设置回调。
# 服务方要求固定地址时才启用；必须属于上面的允许来源。
# TOOL_OAUTH_CALLBACK_URL=https://crew.example.com/api/tool-connections/oauth/callback

# 可选 GitHub 登录：三项一起设置，使用部署者自己的 OAuth App。
# GITHUB_OAUTH_CLIENT_ID=<client ID>
# GITHUB_OAUTH_CLIENT_SECRET=<server-side secret>
# GITHUB_OAUTH_CALLBACK_URL=https://crew.example.com/api/auth/github/callback

# 其余可选参数及备份要求见 .env.example 和 docs/guides/backend-operations.md。
