{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-avatar-manifest.mjs && node scripts/build-brand.mjs && vite",
    "build": "node scripts/build-avatar-manifest.mjs && node scripts/build-brand.mjs && vite build && node scripts/build-failure-pages.mjs && node scripts/build-frontend-compression.mjs",
    "typecheck": "node scripts/build-avatar-manifest.mjs && tsc --noEmit",
    "lint": "eslint src scripts *.ts *.mjs",
    "test": "node scripts/build-avatar-manifest.mjs && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:avatars": "node scripts/build-avatar-manifest.mjs && vitest run src/components/avatars",
    "build:brand": "node scripts/build-brand.mjs",
    "preview": "vite preview",
    "build:avatar-manifest": "node scripts/build-avatar-manifest.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint:scripts": "eslint scripts"
  },
  "packageManager": "pnpm@11.11.0",
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@uiw/react-json-view": "2.0.0-alpha.44",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "prettier": {
    "printWidth": 100
  }
}
